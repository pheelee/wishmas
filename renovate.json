{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "automerge": false,
  "platformAutomerge": true,
  "automergeType": "pr",
  "ignoreTests": false,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/container/(?:release-)?smoke\\.cjs$/"
      ],
      "matchStrings": [
        "'(?<depName>traefik|golang):(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-alpine)?)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?'"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Track indirect Go modules alongside direct modules",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "description": "Keep the Go directive, builder and helper references current",
      "matchManagers": [
        "gomod",
        "dockerfile",
        "custom.regex"
      ],
      "matchPackageNames": [
        "go",
        "golang"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "One checked auto-merge PR for minor, patch and digest maintenance",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "minor and patch dependencies",
      "automerge": true
    },
    {
      "description": "Review major upgrades individually",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "automerge": false
    }
  ],
  "separateMultipleMajor": true,
  "ignorePaths": [
    "**/node_modules/**",
    "**/vendor/**",
    ".work/**",
    "data/**",
    "data2/**",
    "design/**",
    "test-results/**"
  ]
}
